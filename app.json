{
  "expo": {
    "name": "PocketLab",
    "slug": "pocketlab",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pocketlab",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pocketlab.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a"
      },
      "package": "com.pocketlab.app"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-media-library",
      "expo-sqlite"
    ]
  }
}
